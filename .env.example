# =============================================================================
# Minicurso MCP — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores. O `.env` é local e NÃO
# vai para o git (só este modelo é versionado):
#
#   cp .env.example .env      # Linux / macOS
#   copy .env.example .env    # Windows (cmd)
#   Copy-Item .env.example .env   # Windows (PowerShell)

API_URL=http://localhost:8000

AGENTE_SIMULADO=false

#   Anthropic (Claude) — API nativa, SDK oficial `anthropic`
#     LLM_BASE_URL=https://api.anthropic.com
#     LLM_MODELO=claude-opus-5-5         # ou claude-sonnet-5-5 / claude-haiku-5-5
#     LLM_KEY=sk-ant-...
#
#   Google Gemini  ##### IMPORTANTE: a base TERMINA em /openai #####
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODELO=gemini-3.8-flash        # precisa começar com "gemini"
#     LLM_KEY=AIza...
#     # Modelos antigos (ex.: gemini-2.5-flash) são aposentados para contas
#     # novas. Liste os liberados para a sua conta em https://aistudio.google.com
#
#   OpenAI
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODELO=gpt-4o-mini
#     LLM_KEY=sk-...
#
#   OpenRouter
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODELO=openai/gpt-4o-mini      # ou anthropic/claude-opus-5-5, etc.
#     LLM_KEY=sk-or-...
#
#   Groq
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODELO=llama-3.3-70b-versatile
#
#   Ollama (local, sem chave real)
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODELO=llama3.1
#     LLM_KEY=ollama
